# ============================================================
#       AMAZON & FLIPKART AUTOMATED LOOT DEALS BOT CONFIG
# ============================================================

# 1. TELEGRAM SETTINGS
# Step 1: Telegram me @BotFather search karein aur /newbot likh kar bot banayein.
# Step 2: Jo API Token milega use yahan paste karein.
TELEGRAM_BOT_TOKEN=

# Step 3: Telegram channel banayein (Public ya Private)
# Step 4: Apne bot ko channel ka "Administrator" banayein (Post messages permission ke sath)
# Step 5: Agar public channel hai to '@YourChannelUsername' likhein, ya private channel ka Chat ID
TELEGRAM_CHANNEL=@YourChannelUsername

# 2. AFFILIATE CREDENTIALS
# Amazon Associate Tag (e.g., yourdealstag-21)
AMAZON_AFFILIATE_TAG=

# Flipkart Affiliate ID (optional)
FLIPKART_AFFID=

# EarnKaro Referral/User ID (optional - agar aap EarnKaro se multi-store link banana chahte hain)
EARNKARO_USER_ID=

# 3. DEAL FILTER SETTINGS
# Minimum kitna % discount hona chahiye tabhi bot post kare (Recommended: 50 ya 60)
MIN_DISCOUNT_PERCENT=50

# Kitne minute baad bot dobara new deals check kare (Recommended: 15)
CHECK_INTERVAL_MINUTES=15

# 4. BRANDING & CHANNEL DETAILS
CHANNEL_NAME=DealHype
CHANNEL_SIGNATURE=⚡ Fast DealHype! Price change hone se pehle book karein!
